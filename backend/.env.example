# ─────────────────────────────────────────────────────────────────────────────
# OnionGrade AI — backend environment configuration
# Copy this file to .env and fill in your values before starting.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini API key ────────────────────────────────────────────────────────────
# Get a FREE key at: https://aistudio.google.com/apikey
# Leave empty to run in offline OpenCV mode (no API calls, no internet needed).
GOOGLE_API_KEY=your_api_key_here

# ── Gemini model fallback chain ───────────────────────────────────────────────
# Models are tried IN ORDER. If one fails (quota / timeout / not found),
# the next one is automatically tried. All failing → clean HTTP 503 error.
#
# Real model IDs (Google AI SDK, 2025) — 4-tier chain:
#
#   Tier 1 — Latest Flash (fastest, cheapest quota, free-tier friendly):
#     gemini-2.0-flash-lite          ← ultra-fast, lowest quota cost
#     gemini-2.0-flash               ← full gen-2 Flash, better accuracy
#
#   Tier 2 — Stable 1.5 Flash (reliable free-tier fallbacks):
#     gemini-1.5-flash-latest        ← latest 1.5-Flash alias
#     gemini-1.5-flash               ← pinned stable 1.5-Flash
#     gemini-1.5-flash-8b            ← 8B variant, extra quota headroom
#
#   Tier 3 — 2.5 Flash preview (best accuracy on free tier):
#     gemini-2.5-flash-preview-05-20
#
#   Tier 4 — Pro models (highest accuracy, limited free quota):
#     gemini-1.5-pro-latest
#     gemini-1.5-pro
#
#   Tier 4 — 3.x Flash series (experimental, tried opportunistically):
#     gemini-3.5-flash
#     gemini-3.6-flash
#     gemini-3.7-flash
#
#   Tier 5 — Pro models (highest accuracy, limited free quota):
#     gemini-1.5-pro-latest
#     gemini-1.5-pro
#
# Leave commented out to use the full built-in 11-model chain above.
# Uncomment to restrict to specific models only:
# GEMINI_VISION_MODELS=gemini-2.0-flash-lite,gemini-2.0-flash,gemini-1.5-flash

# Legacy single-model pin (prepended to the list above, still supported).
# Uncomment and set if you want one specific model to ALWAYS go first.
# GEMINI_VISION_MODEL=gemini-2.0-flash-lite

# Model used by report_service.py (text generation only, not vision).
GEMINI_MODEL=gemini-2.0-flash-lite

# ── Timeout / retry ───────────────────────────────────────────────────────────
# Seconds to wait for a single Gemini response before timing out.
# Worst-case total = GEMINI_TIMEOUT_SECONDS × (GEMINI_MAX_RETRIES+1) × n_models
# Keep: timeout × 3 attempts × 11 models < 300 s (frontend request timeout).
GEMINI_TIMEOUT_SECONDS=30
# Times to retry the SAME model on timeout/server error (0 = no retry).
GEMINI_MAX_RETRIES=2

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default covers local Streamlit. Add your deployed frontend URL if needed.
ALLOWED_ORIGINS=http://localhost:8501

# ── Demo / offline mode ───────────────────────────────────────────────────────
# Only used when GOOGLE_API_KEY is not set (or left empty above).
# "synthetic" → fixed 12-onion demo batch (works without uploading an image)
# "cv"        → OpenCV detects onions from the ACTUAL uploaded image (offline)
#
# ⚠️  Must be exactly "synthetic" or "cv" — no extra spaces or typos.
DEMO_DATA_MODE=synthetic
